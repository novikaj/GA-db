# Copy this file to ~/.dbt/profiles.yml, then replace the placeholder values.
# Keep the real profiles.yml out of Git: it can contain local credentials.
growth_analytics:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth
      project: YOUR_GCP_PROJECT_ID
      dataset: growth_analytics_dev
      location: EU
      threads: 4
      priority: interactive
